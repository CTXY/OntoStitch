# Copy to .env, fill locally, and export with: set -a; source .env; set +a
CORTEX_LLM_MODEL=your-chat-model
CORTEX_LLM_BASE_URL=https://api.openai.com/v1
CORTEX_LLM_API_KEY=replace-with-your-own-key
CORTEX_EMBEDDING_MODEL=your-embedding-model
# Optional provider-specific switch:
CORTEX_LLM_ENABLE_THINKING=false

# Graph Merge working-state checkpoints (official file-backed SQLite; no server required).
GRAPH_MERGE_CHECKPOINT_URL=sqlite:///workspace/checkpoints/graph_merge.sqlite
# Optional LangSmith native traces and token/cost tracking:
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-your-langsmith-key

# Optional extraction summary tracing
LANGSMITH_PROJECT=autoonto-extract
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
