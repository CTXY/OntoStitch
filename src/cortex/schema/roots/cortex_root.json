        "nullable": {
          "type": "boolean",
          "required": false,
          "description": "数据源约束是否允许该字段为空。",
          "enum": null,
          "default": null
        },
        "semantic_role": {
          "type": "string",
          "required": false,
          "description": "字段在分析和查询生成中的主要语义角色。",
          "enum": [
            "DIMENSION",
            "MEASURE",
            "TIME",
            "IDENTIFIER"
          ],
          "default": null
