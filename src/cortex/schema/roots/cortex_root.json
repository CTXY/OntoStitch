        "description": "The same producer-scoped column business key."
      },
      "merge_role": "fact"
    },
    {
      "id": "dimension_value",
      "family": "structured",
      "name": "标准维度值",
      "description": "字段取值域中需要独立治理、召回、映射或维护别名的标准值；普通样例值不应注册为独立节点。",
      "extends": null,
      "fields": {
        "column_ref": {
          "type": "string",
          "required": false,
          "description": "该维值所属字段的规范 Column 引用。",
          "enum": null,
          "default": null
