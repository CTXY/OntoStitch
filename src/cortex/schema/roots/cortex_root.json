        "value": {
          "type": "string|number|boolean",
          "required": true,
          "description": "写入过滤条件或与数据源值比较时使用的规范真实值。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "exact",
        "fields": [
          "properties.column_ref",
          "properties.value"
        ],
        "description": "The same producer-scoped dimension value."
      },
      "merge_role": "fact"
    },
    {
      "id": "metric",
      "family": "structured",
      "name": "指标",
      "description": "具有稳定业务名称、明确计算表达式和可追踪依赖的量化语义资产；",
      "extends": null,
      "fields": {
        "references": {
          "type": "string[]",
          "required": false,
          "description": "指标直接依赖或用于生成计划的规范资产引用。",
          "enum": null,
          "default": null
        },
        "metric_name": {
          "type": "string",
          "required": false,
          "description": "训练运行时使用的规范指标名称。",
          "enum": null,
          "default": null
        },
        "metric_kind": {
          "type": "string",
          "required": false,
          "description": "指标的业务或计算类别。",
          "enum": null,
          "default": null
        },
        "pattern": {
          "type": "string",
          "required": false,
          "description": "指标口径的自然语言计算模式。",
          "enum": null,
          "default": null
        },
        "expression": {
          "type": "string|object",
          "required": true,
          "description": "可被编译或解释执行的指标计算表达式及口径。",
          "enum": null,
          "default": null
        },
        "filters": {
          "type": "object[]",
          "required": false,
          "description": "指标计算必须施加的固定过滤谓词。",
          "enum": null,
          "default": null
        },
        "default_time": {
          "type": "string",
          "required": false,
          "description": "默认时间分析字段引用。",
          "enum": null,
          "default": null
        },
        "allowed_dimension_refs": {
          "type": "string[]",
          "required": false,
          "description": "允许用于指标分组或切片的字段引用。",
          "enum": null,
          "default": null
        },
        "aggregation_policy": {
          "type": "string",
          "required": false,
          "description": "指标在查询执行中的聚合阶段和组合策略。",
          "enum": [
            "DIRECT_AGGREGATE",
            "POST_AGGREGATE_CALC",
            "AGGREGATE_THEN_JOIN"
          ],
          "default": null
        },
        "calculation_policy": {
          "type": "object",
          "required": false,
          "description": "指标计算阶段和组合方式的结构化补充策略。",
          "enum": null,
          "default": null
        },
        "sql_generation_plans": {
          "type": "object[]",
          "required": false,
          "description": "经编译或人工确认、可供查询生成器执行的结构化计划。",
          "enum": null,
          "default": null
        }
