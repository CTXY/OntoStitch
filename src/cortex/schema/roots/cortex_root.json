        "sample_values": {
          "type": "array",
          "required": false,
          "description": "用于理解字段取值形态的脱敏代表性样例。",
          "enum": null,
          "default": null
        },
        "unit": {
          "type": "string",
          "required": false,
          "description": "字段数值使用的业务计量单位。",
          "enum": null,
          "default": null
