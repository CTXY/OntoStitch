      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "semantic",
        "fields": [
          "name",
          "aliases",
          "properties.metric_name",
          "properties.metric_kind"
        ],
        "description": "The same stable business measure or metric intent. Names, aliases, metric_name, and metric_kind are primary identity evidence. Description, pattern, expression, filters, unit, grain, and generation plans are implementation evidence: differences in them do not alone create a different identity and must be reconciled later. Return a different identity only when the measured business quantity, numerator/denominator meaning, unit semantics, or metric category changes."
      },
      "merge_role": "knowledge"
    },
    {
      "id": "generation_rule",
      "family": "structured",
      "name": "查询生成规则",
      "description": "由自然语言触发并对 SQL 或查询计划进行确定性补充、约束或改写的规则；",
