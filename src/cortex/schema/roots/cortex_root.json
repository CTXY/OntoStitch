{
  "node_types": [
    {
      "id": "table",
      "family": "structured",
      "name": "数据表",
      "description": "可直接参与查询的数据源物理表或逻辑视图；描述数据结构和查询边界，不表示抽象业务概念。",
      "extends": null,
      "fields": {
        "database": {
          "type": "string",
          "required": false,
          "description": "该表所属的数据库、数据源或连接名称。",
          "enum": null,
          "default": null
        },
        "database_description": {
          "type": "string",
          "required": false,
          "description": "所属数据库或数据源的业务范围说明。",
          "enum": null,
          "default": null
        },
        "table_name": {
          "type": "string",
          "required": true,
          "description": "数据源中可被查询引用的物理表名或视图名。",
          "enum": null,
          "default": null
        },
        "table_schema": {
          "type": "string|object",
          "required": false,
          "description": "用于字段解析和查询生成的原始建表语句或结构化 Schema 快照。",
          "enum": null,
          "default": null
        },
        "important_columns": {
          "type": "string[]",
          "required": false,
          "description": "默认召回和查询上下文需要优先保留的字段引用。",
          "enum": null,
          "default": null
        },
        "primary_keys": {
          "type": "string[]",
          "required": false,
          "description": "表的主键字段引用。",
          "enum": null,
          "default": null
        },
        "foreign_keys": {
          "type": "string[]",
          "required": false,
          "description": "表的外键字段引用。",
          "enum": null,
          "default": null
        },
        "available_time_columns": {
          "type": "string[]",
          "required": false,
          "description": "可用于时间过滤和分析的字段引用。",
          "enum": null,
          "default": null
        },
        "default_time_column": {
          "type": "string",
          "required": false,
          "description": "默认时间字段引用。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "exact",
        "fields": [
          "properties.database",
          "properties.table_name"
        ],
        "description": "The same physical table."
      },
      "merge_role": "fact"
    },
    {
      "id": "column",
      "family": "structured",
      "name": "数据字段",
      "description": "数据表中可被投影、计算、过滤、分组或关联的物理字段；字段的业务含义应通过语义角色和关系补充。",
      "extends": null,
      "fields": {
        "table_ref": {
          "type": "string",
          "required": false,
          "description": "该字段所属物理或逻辑表的规范 Table 引用。",
          "enum": null,
          "default": null
        },
        "column_name": {
          "type": "string",
          "required": true,
          "description": "数据源中可被 SQL 引用的物理字段名。",
          "enum": null,
          "default": null
