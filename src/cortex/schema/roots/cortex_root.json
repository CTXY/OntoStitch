{
  "node_types": [
    {
      "id": "table",
      "family": "structured",
      "name": "数据表",
      "description": "可直接参与查询的数据源物理表或逻辑视图；描述数据结构和查询边界，不表示抽象业务概念。",
      "extends": null,
      "fields": {
        "database": {
          "type": "string",
          "required": false,
          "description": "该表所属的数据库、数据源或连接名称。",
          "enum": null,
          "default": null
        },
        "database_description": {
          "type": "string",
          "required": false,
          "description": "所属数据库或数据源的业务范围说明。",
          "enum": null,
          "default": null
        },
        "table_name": {
          "type": "string",
          "required": true,
          "description": "数据源中可被查询引用的物理表名或视图名。",
          "enum": null,
          "default": null
        },
        "table_schema": {
          "type": "string|object",
          "required": false,
          "description": "用于字段解析和查询生成的原始建表语句或结构化 Schema 快照。",
          "enum": null,
          "default": null
        },
        "important_columns": {
          "type": "string[]",
          "required": false,
          "description": "默认召回和查询上下文需要优先保留的字段引用。",
          "enum": null,
          "default": null
        },
        "primary_keys": {
          "type": "string[]",
          "required": false,
          "description": "表的主键字段引用。",
          "enum": null,
          "default": null
        },
        "foreign_keys": {
          "type": "string[]",
          "required": false,
          "description": "表的外键字段引用。",
          "enum": null,
          "default": null
        },
        "available_time_columns": {
          "type": "string[]",
          "required": false,
          "description": "可用于时间过滤和分析的字段引用。",
          "enum": null,
          "default": null
        },
        "default_time_column": {
          "type": "string",
          "required": false,
          "description": "默认时间字段引用。",
          "enum": null,
          "default": null
        },
        "unique_keys": {
          "type": "array",
          "required": false,
          "description": "数据库声明的唯一约束；每项为一个完整唯一键的列名列表。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "exact",
        "fields": [
          "properties.database",
          "properties.table_name"
        ],
        "description": "The same physical table."
      },
      "merge_role": "fact"
    },
    {
      "id": "column",
      "family": "structured",
      "name": "数据字段",
      "description": "数据表中可被投影、计算、过滤、分组或关联的物理字段；字段的业务含义应通过语义角色和关系补充。",
      "extends": null,
      "fields": {
        "table_ref": {
          "type": "string",
          "required": true,
          "description": "该字段所属物理或逻辑表的规范 Table 引用。",
          "enum": null,
          "default": null
        },
        "column_name": {
          "type": "string",
          "required": true,
          "description": "数据源中可被 SQL 引用的物理字段名。",
          "enum": null,
          "default": null
        },
        "data_type": {
          "type": "string",
          "required": false,
          "description": "数据源声明的原始字段类型。",
          "enum": null,
          "default": null
        },
        "sample_values": {
          "type": "array",
          "required": false,
          "description": "用于理解字段取值形态的脱敏代表性样例。",
          "enum": null,
          "default": null
        },
        "unit": {
          "type": "string",
          "required": false,
          "description": "字段数值使用的业务计量单位。",
          "enum": null,
          "default": null
        },
        "nullable": {
          "type": "boolean",
          "required": false,
          "description": "数据源约束是否允许该字段为空。",
          "enum": null,
          "default": null
        },
        "semantic_role": {
          "type": "string",
          "required": false,
          "description": "字段在分析和查询生成中的主要语义角色。",
          "enum": [
            "DIMENSION",
            "MEASURE",
            "TIME",
            "IDENTIFIER"
          ],
          "default": null
        },
        "key_role": {
          "type": "string",
          "required": false,
          "description": "字段的主键、外键或非键角色。",
          "enum": [
            "PRIMARY_KEY",
            "FOREIGN_KEY",
            "NONE"
          ],
          "default": null
        },
        "statistics": {
          "type": "object",
          "required": false,
          "description": "用于理解数据分布和辅助查询规划的字段统计信息。",
          "enum": null,
          "default": null
        },
        "source_metadata": {
          "type": "object",
          "required": false,
          "description": "原始字段业务说明，按来源保留数据库 comment 与外部 metadata；不覆盖物理事实。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "exact",
        "fields": [
          "properties.table_ref",
          "properties.column_name"
        ],
        "description": "The same producer-scoped column business key."
      },
      "merge_role": "fact"
    },
    {
      "id": "dimension_value",
      "family": "structured",
      "name": "标准维度值",
      "description": "字段取值域中需要独立治理、召回、映射或维护别名的标准值；普通样例值不应注册为独立节点。",
      "extends": null,
      "fields": {
        "column_ref": {
          "type": "string",
          "required": true,
          "description": "该维值所属字段的规范 Column 引用。",
          "enum": null,
          "default": null
        },
        "value": {
          "type": "string|number|boolean",
          "required": true,
          "description": "写入过滤条件或与数据源值比较时使用的规范真实值。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "exact",
        "fields": [
          "properties.column_ref",
          "properties.value"
        ],
        "description": "The same producer-scoped dimension value."
      },
      "merge_role": "fact"
    },
    {
      "id": "metric",
      "family": "structured",
      "name": "指标",
      "description": "具有稳定业务名称、明确计算表达式和可追踪依赖的量化语义资产；",
      "extends": null,
      "fields": {
        "references": {
          "type": "string[]",
          "required": false,
          "description": "指标直接依赖或用于生成计划的规范资产引用。",
          "enum": null,
          "default": null
        },
        "pattern": {
          "type": "string",
          "required": false,
          "description": "指标口径的自然语言计算模式。",
          "enum": null,
          "default": null
        },
        "expression": {
          "type": "object",
          "required": true,
          "description": "可被编译或解释执行的指标计算表达式及口径。",
          "enum": null,
          "default": null
        },
        "sql_generation_plans": {
          "type": "object[]",
          "required": false,
          "description": "经编译或人工确认、可供查询生成器执行的结构化计划。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "semantic",
        "fields": [
          "name",
          "aliases"
        ],
        "description": "The same stable business measure or metric intent. Names and aliases identify the business quantity; expression, pattern and SQL generation plans provide implementation evidence to reconcile."
      },
      "merge_role": "knowledge"
    },
    {
      "id": "generation_rule",
      "family": "structured",
      "name": "查询生成规则",
      "description": "由自然语言触发并对 SQL 或查询计划进行确定性补充、约束或改写的规则；",
      "extends": null,
      "fields": {
        "references": {
          "type": "string[]",
          "required": false,
          "description": "condition 明确需要的完整规范资产 ID；所有引用必须共同满足。语义目标编译为 applies_to，物理目标编译为 grounded_on。",
          "enum": null,
          "default": null
        },
        "operation_intent": {
          "type": "string",
          "required": false,
          "description": "Initial Extraction 使用的 Operation Registry 意图提示；不替代 condition/action，也不参与规则 identity。",
          "enum": null,
          "default": null
        },
        "triggers": {
          "type": "object",
          "required": true,
          "description": "自然语言短语与 SQL 操作组成的结构化触发信号。",
          "enum": null,
          "default": null
        },
        "condition": {
          "type": "string",
          "required": true,
          "description": "规则成立和执行的前置条件。",
          "enum": null,
          "default": null
        },
        "action": {
          "type": "string",
          "required": true,
          "description": "规则触发后执行的确定性查询生成动作。",
          "enum": null,
          "default": null
        },
        "reason": {
          "type": "string",
          "required": true,
          "description": "将 action 与同一操作意图的另一种合理实现进行比较，并说明可观察的结果差异。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "semantic",
        "fields": [
          "name",
          "properties.condition",
          "properties.action"
        ],
        "description": "The same reusable SQL generation behavior."
      },
      "merge_role": "knowledge"
    },
    {
      "id": "concept",
      "family": "common",
      "name": "概念",
      "description": "跨结构化与非结构化来源共享的稳定术语、类别或业务含义；概念本身不要求具有具体身份或可直接执行的计算表达式。",
      "extends": null,
      "fields": {
        "definition": {
          "type": "string",
          "required": false,
          "description": "用于消除歧义并支持一致理解的概念规范定义。",
          "enum": null,
          "default": null
        },
        "mapping_type": {
          "type": "string",
          "required": false,
          "description": "概念映射到物理语义资产时采用的映射类别。",
          "enum": null,
          "default": null
        },
        "targets": {
          "type": "object[]",
          "required": false,
          "description": "具有稳定 target ID、表达式、引用和过滤模板的候选展开目标。",
          "enum": null,
          "default": null
        }
      },
      "inclusion_criteria": [],
      "exclusion_criteria": [],
      "identity_policy": {
        "mode": "semantic",
        "fields": [
          "name",
          "aliases",
          "description"
        ],
        "description": "The same normalized business concept."
      },
      "merge_role": "fact"
    }
  ],
  "edge_types": [
    {
      "id": "belongs_to",
      "name": "字段归属",
      "description": "起点 Column 是终点 Table 直接包含的物理字段；只表达字段与所属表的结构归属，不表达跨表关联。",
      "from_node_types": [
        "column"
      ],
      "to_node_types": [
        "table"
      ],
      "fields": {
        "is_default_time": {
          "type": "boolean",
          "required": false,
          "description": "该字段是否为所属表在默认分析和时间过滤中使用的时间列。",
          "enum": null,
          "default": false
        },
        "is_important": {
          "type": "boolean",
          "required": false,
          "description": "该字段是否应作为所属表的重要字段参与默认召回和上下文构建。",
          "enum": null,
          "default": false
        },
        "is_available_time": {
          "type": "boolean",
          "required": false,
          "description": "该字段是否为所属表可用于时间分析的字段。",
          "enum": null,
          "default": false
        },
        "is_primary_key": {
          "type": "boolean",
          "required": false,
          "description": "该字段是否为所属表主键。",
          "enum": null,
          "default": false
        },
        "is_foreign_key": {
          "type": "boolean",
          "required": false,
          "description": "该字段是否为所属表外键。",
          "enum": null,
          "default": false
        }
      },
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "value_of",
      "name": "维值归属",
      "description": "起点 DimensionValue 是终点 Column 取值域中的标准值；用于值召回、别名映射和过滤条件生成。",
      "from_node_types": [
        "dimension_value"
      ],
      "to_node_types": [
        "column"
      ],
      "fields": {},
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "joins_with",
      "name": "明细表连接",
      "description": "两张物理表之间由证据确认的完整等值连接键；不规定具体查询的 JOIN 类型。",
      "from_node_types": [
        "table"
      ],
      "to_node_types": [
        "table"
      ],
      "fields": {
        "column_pairs": {
          "type": "object[]",
          "required": true,
          "description": "完整等值连接列对；每项含 from_column_ref 和 to_column_ref，多项按 AND 组合。",
          "enum": null,
          "default": null
        },
        "cardinality": {
          "type": "string",
          "required": false,
          "description": "仅由数据库声明的键约束确定；方向相对于 from → to，未知时省略。",
          "enum": [
            "1:1",
            "1:N",
            "N:1"
          ],
          "default": null
        }
      },
      "direction_semantics": "连接列等值关系可反向遍历；column_pairs 和 cardinality 按存储的 from/to 定向。",
      "evidence_requirement": "连接键由数据库声明的外键或显式 JOIN ON/USING 的完整直接等值列对确认；IN、EXISTS、WHERE 连接和复杂条件不建边。cardinality 仅由数据库声明的主键和唯一约束推导，未知时省略。",
      "identity_fields": [
        "column_pairs"
      ],
      "directionality": "undirected"
    },
    {
      "id": "aligns_with",
      "name": "聚合结果对齐",
      "description": "起点 Table 与终点 Table 必须先各自聚合，再按声明的共同粒度对齐结果；该关系不表示原始明细记录可以直接连接。",
      "from_node_types": [
        "table"
      ],
      "to_node_types": [
        "table"
      ],
      "fields": {
        "default_join_type": {
          "type": "string",
          "required": true,
          "description": "两侧聚合结果完成粒度对齐时使用的默认 Join 类型。",
          "enum": [
            "INNER",
            "LEFT",
            "RIGHT",
            "FULL",
            "SEMI",
            "ANTI",
            "CROSS"
          ],
          "default": null
        },
        "conditions": {
          "type": "object[]",
          "required": true,
          "description": "两侧独立聚合后用于结果对齐的粒度字段和比较条件。",
          "enum": null,
          "default": null
        }
      },
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "depends_on",
      "name": "指标依赖",
      "description": "起点 Metric 的计算表达式直接依赖终点 Metric；只记录稳定语义依赖。",
      "from_node_types": [
        "metric"
      ],
      "to_node_types": [
        "metric"
      ],
      "fields": {},
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "computed_from",
      "name": "指标固定物理依赖",
      "description": "起点 Metric 的定义不可替换地依赖终点 Column。",
      "from_node_types": [
        "metric"
      ],
      "to_node_types": [
        "column"
      ],
      "fields": {
        "constraint": {
          "type": "string",
          "required": true,
          "description": "替换该字段会改变指标定义的原因。",
          "enum": null,
          "default": null
        }
      },
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "analyzable_by",
      "name": "可分析维度",
      "description": "起点 Metric 可以按照终点 Column 进行分组、切片或时间分析；该关系不表示指标表达式直接引用该字段。",
      "from_node_types": [
        "metric"
      ],
      "to_node_types": [
        "column"
      ],
      "fields": {
        "is_default_time": {
          "type": "boolean",
          "required": false,
          "description": "该字段是否为此指标进行默认时间分析时使用的时间列。",
          "enum": null,
          "default": false
        }
      },
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "filters_on",
      "name": "固定字段过滤",
      "description": "起点 Metric 或 Concept 的稳定业务口径要求对终点 Column 施加固定过滤；不记录用户查询运行时临时输入的过滤条件。",
      "from_node_types": [
        "metric",
        "concept"
      ],
      "to_node_types": [
        "column"
      ],
      "fields": {
        "operator": {
          "type": "string",
          "required": true,
          "description": "生成字段过滤表达式时使用的规范比较操作符。",
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "IN",
            "NOT_IN",
            "BETWEEN",
            "LIKE",
            "IS_NULL",
            "IS_NOT_NULL"
          ],
          "default": null
        },
        "values": {
          "type": "array",
          "required": true,
          "description": "与操作符配套的规范过滤值；空值判断操作符可使用空数组。",
          "enum": null,
          "default": null
        },
        "target_id": {
          "type": "string",
          "required": false,
          "description": "Concept 多目标映射中该过滤所属的稳定 target ID。",
          "enum": null,
          "default": null
        },
        "predicate_id": {
          "type": "string",
          "required": false,
          "description": "过滤谓词在训练 revision 中的稳定 ID。",
          "enum": null,
          "default": null
        },
        "value_refs": {
          "type": "string[]",
          "required": false,
          "description": "过滤值对应的 DimensionValue 节点引用。",
          "enum": null,
          "default": null
        },
        "pattern": {
          "type": "string",
          "required": false,
          "description": "LIKE 等模式匹配谓词使用的规范模式。",
          "enum": null,
          "default": null
        }
      },
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "grounded_on",
      "name": "资产物理落地",
      "description": "资产完整定义使用的物理对象。Concept 的每个 target.references 生成带 target_id 的依赖边；Metric 和 GenerationRule 依赖不带 target_id。该边不表示语义等价或计算角色。",
      "from_node_types": [
        "concept",
        "metric",
        "generation_rule"
      ],
      "to_node_types": [
        "table",
        "column",
        "dimension_value"
      ],
      "fields": {
        "target_id": {
          "type": "string",
          "required": false,
          "description": "Concept target 的稳定局部 ID；Concept 必填，Metric/GenerationRule 禁止。",
          "enum": null,
          "default": null
        }
      },
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": [
        "target_id"
      ]
    },
    {
      "id": "applies_to",
      "name": "生成规则适用范围",
      "description": "由 GenerationRule references 确定性编译；起点规则的定义或适用范围强依赖终点 Metric 或 Concept。",
      "from_node_types": [
        "generation_rule"
      ],
      "to_node_types": [
        "metric",
        "concept"
      ],
      "fields": {},
      "direction_semantics": null,
      "evidence_requirement": null,
      "identity_fields": []
    },
    {
      "id": "expands_to",
      "name": "概念展开",
      "description": "起点 Concept 可以直接展开为终点 Metric 或更具体的 Concept，用于把抽象用户意图转换为可查询语义；只保存直接展开关系。",
      "from_node_types": [
        "concept"
      ],
      "to_node_types": [
        "metric",
        "concept"
      ],
      "fields": {
        "target_id": {
          "type": "string",
          "required": false,
          "description": "Concept 多目标映射中的稳定 target ID。",
          "enum": null,
          "default": null
        }
      },
      "direction_semantics": null,
      "evidence_requirement": null,
