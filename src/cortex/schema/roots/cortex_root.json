        "references": {
          "type": "string[]",
          "required": false,
          "description": "字段所属表等规范资产引用。",
          "enum": null,
          "default": null
        },
        "key_role": {
          "type": "string",
          "required": false,
          "description": "字段的主键、外键或非键角色。",
          "enum": [
            "PRIMARY_KEY",
            "FOREIGN_KEY",
            "NONE"
          ],
          "default": null
        },
        "statistics": {
          "type": "object",
          "required": false,
          "description": "用于理解数据分布和辅助查询规划的字段统计信息。",
          "enum": null,
          "default": null
        }
