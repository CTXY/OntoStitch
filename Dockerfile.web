FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY configs/ ./configs/
COPY examples/ontology/ ./examples/ontology/
RUN pip install --no-cache-dir '.[web]'
ENV CORTEX_PROJECT_ROOT=/app CORTEX_WEB_DATABASE_ROOT=/data/databases CORTEX_WEB_STORAGE=/data/runtime CORTEX_WEB_EXAMPLES=/app/examples/ontology
EXPOSE 8011
CMD ["uvicorn", "cortex.web.app:app", "--host", "0.0.0.0", "--port", "8011", "--workers", "1"]
