      {
        "id": "concept.patient_identifier",
        "node_type": "concept",
        "name": "patient identifier",
        "description": "The identification number of a patient. Patient.ID is the canonical identifier of each patient record; Laboratory.ID and Examination.ID carry that same patient number on laboratory records and examination records and are used to relate those records to their patient. Patients are counted on the distinct canonical identifier so a patient with several records is counted once.",
        "aliases": [],
        "tags": [],
        "properties": {
          "definition": "The identification number of a patient. Patient.ID is the canonical identifier of each patient record; Laboratory.ID and Examination.ID carry that same patient number on laboratory records and examination records and are used to relate those records to their patient. Patients are counted on the distinct canonical identifier so a patient with several records is counted once.",
          "targets": [
            [
              "column.Patient.ID"
            ],
            [
              "column.Laboratory.ID"
            ],
            [
              "column.Examination.ID"
            ]
          ],
          "target_expressions": {},
          "relation_metadata": [
            {
              "id": "patient_identifier_storage_roles",
              "edges": [
                "edge.patient_identifier_grounded_on_patient_id",
                "edge.patient_identifier_grounded_on_laboratory_id",
                "edge.patient_identifier_grounded_on_examination_id"
              ],
              "description": "Patient.ID is the canonical recorded patient number. Laboratory.ID and Examination.ID carry that number on their own rows and are related to Patient.ID by the recorded equality joins; they serve as the identifier by which laboratory and examination records are attributed to a patient. Counting DISTINCT Patient.ID therefore counts each qualifying patient once even when several laboratory or examination rows match."
            }
          ]
        },
