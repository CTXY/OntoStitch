    {
      "topic": "operations",
      "actual_json": "docs/design/reconciliation-review/guidance/operations.actual.json",
      "actual_json_sha256": "b255eb277905011aff0406c4a631bb6f88a6302228fcf02c0852ba84b2538444",
      "actual_canonical_json_sha256": "35bb732eb80cf24b68ee1adf39ea18ce693b704cb6f4e69821a82cf1f378b05c",
      "actual_return_characters": 2601,
      "translation": "docs/design/reconciliation-review/guidance/operations.zh.md",
      "translation_characters": 1162,
      "translation_sha256": "5924d41d572859fe1aa8c5863334fe6666ae86dd8599fa8855cc4ab7ac7237b0",
      "intent_count": 14,
      "intent_alignment": [
        {
          "intent_id": "joinability",
          "source": "Choose the table path or key relationship that connects already-complete meanings. The path may be direct or may use one routing table.",
          "translation": "选择连接已完整表达的含义所需的表路径或键关系。路径可以是直接路径，也可以使用一张路由表。"
        },
        {
          "intent_id": "population_average_comparison",
          "source": "Compare an already-complete stored meaning or Metric with its average over the same requested population; keep averaging and comparison in the Rule, not a helper Metric.",
          "translation": "将已完整表达的存储含义或 Metric 与同一请求总体上的平均值比较；平均计算与比较留在 Rule 中，不创建辅助 Metric。"
        },
        {
          "intent_id": "count_aggregation",
          "source": "Return the number of requested entities or values.",
          "translation": "返回请求实体或取值的数量。"
        },
        {
          "intent_id": "existence_check",
          "source": "Return whether at least one qualifying result exists.",
          "translation": "返回是否至少存在一个满足条件的结果。"
        },
        {
          "intent_id": "boolean_output_encoding",
          "source": "Return the requested yes/no answer as output labels.",
          "translation": "使用输出标签返回请求的 yes/no 答案。"
        },
        {
          "intent_id": "result_deduplication",
          "source": "Return each requested output item or output tuple once when the SQL source can produce duplicate rows.",
          "translation": "当 SQL 来源可能产生重复行时，每个请求输出项或输出元组只返回一次。"
        },
        {
          "intent_id": "extreme_value_selection",
          "source": "Return one scalar minimum or maximum value, not its carrying row.",
          "translation": "返回一个标量最小值或最大值，不返回承载该值的行。"
        },
        {
          "intent_id": "top_k_selection",
          "source": "Return entity rows associated with the leading or trailing K values. K may be one. This fixes ranking and row inclusion, not which physical field representations are output. Passing requested attributes through is allowed; an additional fixed field-set policy is a separate decision. For competition ranking, rank is one plus the number of eligible rows strictly ahead: counting strictly better rows can preserve ties. Check identical eligibility, grouping and NULL ordering before treating an alternative to a window function as incorrect.",
          "translation": "返回与排在最前或最后 K 个取值对应的实体行。K 可以是一。它决定排名和行是否纳入，不决定输出哪些物理字段表示。允许透传请求属性；额外固定字段集合策略属于单独决策。对于竞赛排名，rank 等于严格排在前面的合格行数加一：统计严格更优行可以保留并列。将窗口函数的某个替代实现判断为错误前，检查是否使用相同的入选条件、分组与 NULL 排序。"
        },
        {
          "intent_id": "rank_output",
          "source": "Return an ordinal or tie-aware rank value for each requested result row.",
          "translation": "为每个请求结果行返回序数排名或考虑并列的排名值。"
        },
        {
          "intent_id": "column_binding_choice",
          "source": "Choose which supported fields, joint field groups or representations participate in the answer when evidence establishes a consequential choice beyond static Concept matching. This selects content, not its column order, formatting or row/column output shape. Choosing a field set does not also decide how the already-selected values are arranged; that is an independent decision. Do not repeat an already resolved term-to-field/value mapping.",
          "translation": "当证据表明存在超出静态 Concept 匹配、且会产生实质结果差别的选择时，决定哪些受支持字段、联合字段组或表示参与答案。它选择内容，不选择列顺序、格式或行/列输出形状。选择字段集合，不同时决定如何排列已选取的值；排列是独立决策。不要重复已经解决的术语到字段/值映射。"
        },
        {
          "intent_id": "aggregation_grain",
          "source": "Preserve the requested counting or aggregation unit across repeated records and joins; distinguish row, object and event grain.",
          "translation": "在重复记录与连接中保留请求的计数或聚合单位；区分行、对象与事件粒度。"
        },
        {
          "intent_id": "null_semantics",
          "source": "Preserve an evidenced NULL meaning in filtering, aggregation or arithmetic rather than treating missing values as a documented value without support.",
          "translation": "保留筛选、聚合或算术中有证据支持的 NULL 含义，不得无依据地把缺失值当成已记录值。"
        },
        {
          "intent_id": "temporal_alignment",
          "source": "Choose the supported occurrence time, interval boundaries and temporal alignment for the requested business event or duration.",
          "translation": "为请求的业务事件或时长选择有依据的发生时间、区间边界与时间对齐方式。"
        },
        {
          "intent_id": "population_scope",
          "source": "Preserve the requested population and intrinsic metric scope when evidence distinguishes the intended group or side of a calculation.",
          "translation": "当证据区分了计算中所指的组或某一侧时，保留请求总体与固有 Metric 范围。"
        }
      ]
    }
  ]
}
